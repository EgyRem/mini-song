{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": "backend",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "backend/**/*.js": {}
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/backend/uploads/$1"
    }
  ]
}
